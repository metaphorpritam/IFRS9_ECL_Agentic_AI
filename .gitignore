# secrets — never committed (rotate immediately if one ever lands in history)
.env
.env.*
!.env.example
*.key
*credentials*
*.pem

# data — raw/processed panels are licensed downloads, never redistributed via git
data/raw/
data/processed/
data/scenarios/
data/SFLLD/
!data/**/.gitkeep
!data/**/README.md

# python
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# node / frontend
node_modules/
app/ui/dist/

# model warm-start caches (joblib; rebuilt on demand — staleness rule in
# agent/tools_tier1.py) and the runtime agent audit trail
outputs/models/
outputs/agent_log/

# misc
.DS_Store
*.log
